<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <Version>0.1.0</Version><ShiroBotPluginPackagingEnabled>true</ShiroBotPluginPackagingEnabled>
    <ShiroBotSourceRoot Condition="'$(ShiroBotSourceRoot)' == '' and Exists('$(MSBuildThisFileDirectory)../ShiroBot/SDK/ShiroBot.SDK.csproj')">$(MSBuildThisFileDirectory)../ShiroBot</ShiroBotSourceRoot>
    <ShiroBotSourceRoot Condition="'$(ShiroBotSourceRoot)' == ''">$(MSBuildThisFileDirectory)../../ShiroBot</ShiroBotSourceRoot>
    <ShiroBotPluginSharedAssemblies>ShiroBot.Model.QQ;ShiroBot.Model.Discord;ShiroBot.Model.Telegram</ShiroBotPluginSharedAssemblies>
  </PropertyGroup>
  <Import Project="$(ShiroBotSourceRoot)/SDK/buildTransitive/ShiroBot.SDK.props" />
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="$(ShiroBotSourceRoot)/SDK/ShiroBot.SDK.csproj" Private="false" />
    <ProjectReference Include="$(ShiroBotSourceRoot)/Models/QQ/ShiroBot.Model.QQ.csproj" Private="false" />
    <ProjectReference Include="$(ShiroBotSourceRoot)/Models/Discord/ShiroBot.Model.Discord.csproj" Private="false" />
    <ProjectReference Include="$(ShiroBotSourceRoot)/Models/Telegram/ShiroBot.Model.Telegram.csproj" Private="false" />
    <Compile Remove="tests/**/*.cs" /><Compile Remove="tools/**/*.cs" /><EmbeddedResource Include="Web/index.html" /><EmbeddedResource Include="Web/llm.md" />
    <InternalsVisibleTo Include="DebugAdapter.Tests" />
  </ItemGroup>
  <Import Project="$(ShiroBotSourceRoot)/SDK/buildTransitive/ShiroBot.SDK.targets" />
</Project>
